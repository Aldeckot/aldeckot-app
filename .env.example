# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
# Nunca use uma Service Role Key no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_SUA_PUBLISHABLE_KEY

# Exclusivas do servidor/Vercel. Nunca publique nem copie para supabase-config.js.
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SUA_SERVICE_ROLE_KEY
ALDECKOT_BOOTSTRAP_ADMIN_NAME=Nome do administrador inicial
ALDECKOT_BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
ALDECKOT_BOOTSTRAP_ADMIN_PASSWORD=defina-uma-senha-segura
